#!/bin/sh /etc/rc.common
START=94
USE_PROCD=1
start_service() {
    [ -f /etc/profinet-service.conf ] && . /etc/profinet-service.conf
    procd_open_instance
    procd_set_param command /usr/bin/python3 /root/mudi_profinet.py
    procd_set_param env PNIO_HOST="${PNIO_HOST:-10.10.0.1}" PNIO_IFACE="${PNIO_IFACE:-eth0}" PNIO_PORT="${PNIO_PORT:-8088}" PYTHONPATH="/opt/profinet-service/vendor"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
